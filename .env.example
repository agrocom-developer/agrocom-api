# Placeholder hasta el esqueleto real de Laravel (Sprint 1, TE-01 —
# docs/gestion/plan_sprints.md). Ver docs/gestion/entornos.md para cómo se
# gestiona cada entorno. Este archivo se versiona; el .env real de cada
# entorno, nunca.

APP_NAME=Agrocom
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=es

# Base de datos — PostgreSQL 16 (docs/decisiones/0001-base-de-datos-postgresql.md)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agrocom
DB_USERNAME=
DB_PASSWORD=

# Colas
QUEUE_CONNECTION=database

# Sesión / panel web (AdminLTE + Livewire — docs/decisiones/0002-panel-web-adminlte-livewire-atomic-design.md)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=localhost

# Almacenamiento de evidencias y reportes — S3-compatible
# (docs/decisiones/0009-organizacion-recursos-evidencias-reportes-assets.md)
FILESYSTEM_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# Correo
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-responder@agrocom.example
MAIL_FROM_NAME="${APP_NAME}"

# Monitoreo
SENTRY_LARAVEL_DSN=
