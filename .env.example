# Ver docs/gestion/entornos.md para cómo se gestiona cada entorno.
# Este archivo se versiona; el .env real de cada entorno, nunca.

APP_NAME=Agrocom
# Se muestra en el pie del panel; vacía, el pie no muestra versión.
APP_VERSION=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos — PostgreSQL 16 (docs/decisiones/0001-base-de-datos-postgresql.md).
# DB_HOST=db es el nombre del servicio en docker-compose.yml, porque la app
# corre dentro del contenedor (docs/decisiones/0010-entorno-local-docker-compose.md);
# el .env le gana al environment del compose bajo `artisan serve`. Si corrés
# Laravel fuera de Docker, usá DB_HOST=127.0.0.1.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=agrocom
DB_USERNAME=agrocom
DB_PASSWORD=agrocom
# Prefijo global opcional de tablas (estilo $table_prefix de WordPress).
# Vacío por defecto; los prefijos de módulo (com_, ope_, ...) son parte del
# nombre físico de cada tabla y no dependen de esta variable.
DB_TABLE_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sanctum autentica la app de campo por token de dispositivo (HU-03), no por
# cookie: el modo SPA está apagado en config/sanctum.php y STATEFUL_DOMAINS no
# tiene efecto. Se deja documentado para que nadie lo agregue creyendo que hace
# falta. TOKEN_PREFIX sí sirve: con un prefijo reconocible, los escáneres de
# secretos de GitHub detectan un token filtrado.
SANCTUM_TOKEN_PREFIX=

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# Almacenamiento de evidencias y reportes — S3-compatible
# (docs/decisiones/0009-organizacion-recursos-evidencias-reportes-assets.md).
# En staging/producción: FILESYSTEM_DISK=r2 con las credenciales cargadas.
FILESYSTEM_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# Correo — Mailpit (servicio `mail` de docker-compose.yml), UI en
# http://localhost:8025. `MAIL_HOST=mail` es el nombre del servicio, válido
# desde DENTRO del contenedor `app` (DNS interno de Docker); corriendo la
# app directo en el host (fuera de compose) usá `127.0.0.1` en su lugar.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-responder@agrocom.example
MAIL_FROM_NAME="${APP_NAME}"

# Documentación OpenAPI (docs/decisiones/0014-documentacion-api-code-first-openapi.md).
# La UI en /api/documentation solo existe en entornos no productivos (la
# deshabilita el middleware según APP_ENV, no esta variable). En local conviene
# regenerar el spec en cada request; en staging dejarlo en false y regenerar
# con `composer openapi`.
L5_SWAGGER_GENERATE_ALWAYS=true

# Operaciones — tolerancia de solape entre sesiones (espec §5, HU-07).
# Todavía sin valor de negocio definido ("a definir con la experiencia de
# campo", espec línea 454): el default de config/operaciones.php (0.00) es un
# placeholder conservador, no la cifra real.
OPERACIONES_TOLERANCIA_SOLAPE_HECTAREAS=0.00

# Monitoreo
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
